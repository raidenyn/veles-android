<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only adb surface (OTP-09 design D5, OTP-10 design D5). The receiver is exported so
    `adb shell am broadcast` can reach it, but `android.permission.DUMP` restricts callers to
    the shell; no app, content provider or web content can send these actions. The pairing
    screen is exported for `adb shell am start` and is not launcher-visible.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="me.nagaev.veles.debugpairing.PairingDebugScreen"
            android:exported="true"
            android:label="@string/pairing_debug_title"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name="me.nagaev.veles.debugpairing.PairingDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="me.nagaev.veles.debugpairing.START" />
                <action android:name="me.nagaev.veles.debugpairing.CANCEL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="me.nagaev.veles.debugprobe.ProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="me.nagaev.veles.debug.EXPORT_IDENTITY" />
                <action android:name="me.nagaev.veles.debug.INJECT_PEER" />
                <action android:name="me.nagaev.veles.debug.PUSH" />
                <action android:name="me.nagaev.veles.debug.REVOKE_PEER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
