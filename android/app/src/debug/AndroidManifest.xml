<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only adb surface (OTP-09 design D5, OTP-10 design D5, OTP-12 design D3/D4). The
    receiver is exported so `adb shell am broadcast` can reach it, but `android.permission.DUMP`
    restricts callers to the shell; no app, content provider or web content can send these
    actions. The pairing screen is exported for `adb shell am start` and is not launcher-visible.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        OTP-12 Gate B: the scheduled synthetic push holds a partial wake lock for the delay, so
        the debug build declares WAKE_LOCK. It is not a release-guard string (a library may merge
        it into release), and no fixture class, action or tag exists outside this debug source set.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <activity
            android:name="me.nagaev.veles.debugpairing.PairingDebugScreen"
            android:exported="true"
            android:label="@string/pairing_debug_title"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name="me.nagaev.veles.debugpairing.PairingDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="me.nagaev.veles.debugpairing.START" />
                <action android:name="me.nagaev.veles.debugpairing.CANCEL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="me.nagaev.veles.debugprobe.ProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="me.nagaev.veles.debug.EXPORT_IDENTITY" />
                <action android:name="me.nagaev.veles.debug.INJECT_PEER" />
                <action android:name="me.nagaev.veles.debug.PUSH" />
                <action android:name="me.nagaev.veles.debug.REVOKE_PEER" />
                <action android:name="me.nagaev.veles.debug.GATE_B_SEED" />
                <action android:name="me.nagaev.veles.debug.GATE_B_DISARM" />
                <action android:name="me.nagaev.veles.debug.GATE_B_SCHEDULE_PUSH" />
                <action android:name="me.nagaev.veles.debug.GATE_B_CANCEL_PUSH" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
