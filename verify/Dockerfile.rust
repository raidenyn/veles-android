# Reference build environment for reproducible Rust JNI/WASM verification.
ARG JAVA_IMAGE=eclipse-temurin:21.0.12_8-jdk-noble@sha256:1ca5e470ad60db0d5b4137c1357068fa210051d815ad98ea9964f4bbe7367f8c
FROM ${JAVA_IMAGE}

ENV TZ=UTC LANG=C.UTF-8 LC_ALL=C.UTF-8
ENV ANDROID_HOME=/opt/android-sdk RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
# Pin GRADLE_USER_HOME inside the image so the Gradle wrapper distribution
# cached during the online image build (see the wrapper pre-cache step below)
# is found by BOTH the online `prepare` and the offline `--network=none`
# `package` container runs. The wrapper stores its downloaded distribution
# under ${GRADLE_USER_HOME}/wrapper/dists/; without this pre-cache the offline
# package run re-downloaded gradle-9.5.0-bin.zip and failed with
# java.net.UnknownHostException: services.gradle.org.
ENV GRADLE_USER_HOME=/opt/gradle-home
ENV PATH=${CARGO_HOME}/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/build-tools/36.0.0:/opt/node/bin:${PATH}

# Base apt packages are installed unversioned to match the reviewed pattern in
# verify/Dockerfile: the supply-chain pin discipline is on the build tools
# (Rust/Node/NDK below, each SHA-pinned), not on apt plumbing whose exact
# patch versions churn out of the base image's repo between image rebuilds.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl unzip ca-certificates build-essential \
 && rm -rf /var/lib/apt/lists/*

ARG CMDLINE_TOOLS=11076708
ARG CMDLINE_TOOLS_SHA256=2d2d50857e4eb553af5a6dc3ad507a17adf43d115264b1afc116f95c92e5e258
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools \
 && curl -fsSL -o /tmp/cmdline-tools.zip "https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS}_latest.zip" \
 && echo "${CMDLINE_TOOLS_SHA256}  /tmp/cmdline-tools.zip" | sha256sum -c - \
 && unzip -q /tmp/cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools \
 && mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest \
 && rm /tmp/cmdline-tools.zip

ARG PLATFORM_TOOLS_VERSION=37.0.1
ARG PLATFORM_TOOLS_SHA256=d230f13842f60f782a8645f9c813f8f845bf36089ea7289f28c48f17979313f1
RUN curl -fsSL -o /tmp/platform-tools.zip "https://dl.google.com/android/repository/platform-tools_r${PLATFORM_TOOLS_VERSION}-linux.zip" \
 && echo "${PLATFORM_TOOLS_SHA256}  /tmp/platform-tools.zip" | sha256sum -c - \
 && unzip -q /tmp/platform-tools.zip -d ${ANDROID_HOME} \
 && rm /tmp/platform-tools.zip \
 && grep -qx "Pkg.Revision=${PLATFORM_TOOLS_VERSION}" ${ANDROID_HOME}/platform-tools/source.properties

ARG NDK_VERSION=29.0.14206865
# Install the Android SDK packages the Rust reference image needs, then verify
# each installed package's Pkg.Revision pin. The previous single RUN chained
# `sdkmanager ... && grep -qx ...` for all three pins in one command; when
# sdkmanager exited 1 (after unzipping) the subsequent grep checks failed
# SILENTLY with no diagnostics, so the next CI run could not pinpoint the
# drift. Split sdkmanager from the grep checks and give each pin its own
# guarded `grep ... || { echo actual:; cat <path>/source.properties; exit 1; }`
# block that prints the actual Pkg.Revision on mismatch before exiting 1. The
 # pins are kept (not guessed); the diagnostics will reveal any drift on the
 # next CI run. sdkmanager is isolated on its own line so its failure is not
 # masked by a misleading "Pkg.Revision drift" echo from a later check.
 # The NDK source.properties uses "Pkg.Revision = <value>" (spaces around '='),
 # unlike the platform-tools / build-tools / android-35 files which use the
 # "Pkg.Revision=<value>" form. The NDK pin check uses grep -Eq with
 # "Pkg\.Revision *= *<value>$" to match the actual NDK file's spaced form
 # while still tolerating the no-space form. The android-35 and build-tools
 # pins keep their exact -qx no-space greps (those files use the no-space form).
 RUN yes | sdkmanager --licenses > /dev/null \
  && sdkmanager "platforms;android-35" "build-tools;36.0.0" "ndk;${NDK_VERSION}" \
  && (grep -qx 'Pkg.Revision=2' ${ANDROID_HOME}/platforms/android-35/source.properties \
       || { echo 'android-35 Pkg.Revision drift, actual:'; cat ${ANDROID_HOME}/platforms/android-35/source.properties; exit 1; }) \
  && (grep -qx 'Pkg.Revision=36.0.0' ${ANDROID_HOME}/build-tools/36.0.0/source.properties \
       || { echo 'build-tools/36.0.0 Pkg.Revision drift, actual:'; cat ${ANDROID_HOME}/build-tools/36.0.0/source.properties; exit 1; }) \
  && (grep -Eq 'Pkg\.Revision *= *'"${NDK_VERSION}"'$' ${ANDROID_HOME}/ndk/${NDK_VERSION}/source.properties \
       || { echo "ndk/${NDK_VERSION} Pkg.Revision drift, actual:"; cat ${ANDROID_HOME}/ndk/${NDK_VERSION}/source.properties; exit 1; })

ARG RUSTUP_VERSION=1.29.0
ARG RUSTUP_SHA256=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10
RUN curl -fsSL -o /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
 && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain none \
 && rm /tmp/rustup-init

RUN curl -fsSL -o /tmp/node.tar.xz https://nodejs.org/dist/v26.8.1/node-v26.8.1-linux-x64.tar.xz \
 && echo '3e301118d7df53d563b7e96c1617545f26e2f76f9724be668d6cab65c15dda5d  /tmp/node.tar.xz' | sha256sum -c - \
 && mkdir /opt/node \
 && tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1 \
 && rm /tmp/node.tar.xz \
 && test "$(node --version)" = v26.8.1 \
 && test "$(npm --version)" = 11.19.0

COPY rust/rust-toolchain.toml rust/toolchain-tools.toml /tmp/veles-rust/
# rust-toolchain.toml activates the exact pin only while this directory is
# current. Make its installed Linux host toolchain the image default so the
# later /work/src commands have rustc and cargo before source is copied.
RUN cd /tmp/veles-rust \
 && rustup show active-toolchain \
 && rustup default 1.98.0-x86_64-unknown-linux-gnu \
 && rustc --version \
 && rm -rf /tmp/veles-rust

# Pre-cache the exact pinned Gradle wrapper distribution during the online
# image build so the offline `package` container run (docker run --network=none)
# resolves gradle-9.5.0-bin.zip from ${GRADLE_USER_HOME}/wrapper/dists instead
# of hitting services.gradle.org (which is unreachable under network denial).
# The distribution SHA-256 is pinned by the wrapper itself
# (gradle/wrapper/gradle-wrapper.properties distributionSha256Sum is absent, so
# the wrapper only downloads the exact distributionUrl; we additionally assert
# the downloaded dist sha256 matches the upstream-published checksum to guard
# against a compromised or drifted distribution). Only the wrapper files and
# gradlew are needed to drive `--version`; no project source is copied here.
ARG GRADLE_DISTRIBUTION_SHA256=553c78f50dafcd54d65b9a444649057857469edf836431389695608536d6b746
COPY gradle/wrapper/gradle-wrapper.properties gradle/wrapper/gradle-wrapper.jar gradlew /tmp/veles-gradle/
RUN cd /tmp/veles-gradle \
 && chmod +x gradlew \
 && ./gradlew --version \
 && dist_dir="$(find ${GRADLE_USER_HOME}/wrapper/dists -name 'gradle-9.5.0-bin.zip' -print -quit)" \
 && test -n "$dist_dir" \
 && actual_sha="$(sha256sum "$dist_dir" | cut -d' ' -f1)" \
 && test "$actual_sha" = "$GRADLE_DISTRIBUTION_SHA256" \
 && rm -rf /tmp/veles-gradle

COPY verify/rust-inner.sh /usr/local/bin/rust-inner.sh
RUN chmod +x /usr/local/bin/rust-inner.sh
ENTRYPOINT ["/usr/local/bin/rust-inner.sh"]
