{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"]
    },
    "include": ["src/**/*.d.ts", "test/**/*.ts", "scripts/**/*.mjs"]
}
