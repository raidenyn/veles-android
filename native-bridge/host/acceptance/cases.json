    {
      "id": "windows.AB.lifecycle-port-disconnect",
      "platform": "windows",
      "phones": "AB",
      "action": "lifecycle-port-disconnect",
      "kind": "chrome",
      "description": "Separate Chrome-owned lifecycle case (literal_port_disconnect) with active scan and two byte-proven links",
      "binary": "production",
      "default_status": "NOT RUN",
      "required_actions": [
        "launch_chrome_disposable",
        "load_extension",
        "connect_native",
        "negotiate_ready",
        "start_scan",
        "connect_phone_A",
        "connect_phone_B",
        "prove_bytes_both_links",
        "literal_port_disconnect",
        "observe_last_json",
        "observe_stdout_close",
        "observe_process_exit",
        "observe_link_release",
        "record_pending_disposition"
      ],
      "required_controls": [
        "bytes_proven_before_trigger",
        "release_measured_independently_of_process_exit",
        "survivor_progress_not_applicable_for_global_trigger"
      ],
      "min_links": 2,
      "active_scans": true,
      "requires_chrome": true,
      "requires_signing": false,
      "requires_test_manifest": true,
      "requires_os_context": true,
      "requires_adapter_context": true,
      "observations": [
        "no_top_level_window",
        "no_network_endpoint",
        "no_filesystem_write_outside_test_dirs",
        "no_registry_write_outside_test_manifest"
      ],
      "wrapper_exception": {
        "allowed": true,
        "scope": "windows_chrome_never_visible_wrapper_only",
        "requires_record": true
      },
      "pending_request_handling": {
        "mode": "eof_unobservable",
        "trigger": "literal_port_disconnect",
        "per_request_outcome": "unknown",
        "host_correlated_cancellation_claim": "forbidden",
        "synthesized_port_closed": "local_only_never_host_proof",
        "rationale": "Option 2 (user decision 2026-11-02): an abrupt EOF on the Native Messaging pipe (literal port.disconnect(), connector tab close, Chrome-owned pipe closure) leaves no channel on which the host's per-request terminal events can be observed: the connector is detached and Chrome owns the pipe. The individual pending request's outcome is therefore recorded as unknown / not observable. The connector's own synthesized internal/port_closed is local only and is never evidence that the host cancelled anything. This case verifies process exit and OS BLE link release for both phones only."
      }
    },
