      "platform": "windows",
      "phones": "AB",
      "action": "transfer-boundaries",
      "kind": "chrome",
      "description": "Two-phone byte-exact transfers at boundary sizes plus 0/4097/5120 rejection; connector never sees fragments",
      "binary": "production",
      "default_status": "NOT RUN",
      "required_actions": [
        "launch_chrome_disposable",
        "load_extension",
        "connect_native",
        "negotiate_ready",
        "connect_phone_A",
        "connect_phone_B",
        "send_boundary_sizes",
        "send_rejected_sizes",
        "observe_phone_receipts",
        "observe_hygiene"
      ],
      "required_controls": [
        "per_phone_expected_digest_differs",
        "rejected_sizes_produce_no_gatt_writes",
        "connector_sees_no_fragments"
      ],
      "sizes": {
        "accept": [
          1,
          "chunk-1",
          "chunk",
          "chunk+1",
          "multiple-of-chunk",
          4095,
          4096
        ],
        "reject_without_writes": [
          0,
          4097,
          5120
        ]
      },
