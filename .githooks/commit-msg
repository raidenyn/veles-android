#!/bin/sh
# Conventional Commits check. Needs Python 3.8+ (python3, python or the Windows "py -3" launcher).
root=$(git rev-parse --show-toplevel) || exit 1
ok='import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)'
if python3 -c "$ok" >/dev/null 2>&1; then
    exec python3 -I "$root/scripts/commitlint.py" --allow-git-generated --file "$1"
elif python -c "$ok" >/dev/null 2>&1; then
    exec python -I "$root/scripts/commitlint.py" --allow-git-generated --file "$1"
elif py -3 -c "$ok" >/dev/null 2>&1; then
    exec py -3 -I "$root/scripts/commitlint.py" --allow-git-generated --file "$1"
fi
echo "commit-msg hook needs Python 3.8+ (python3, python or py -3) on PATH; install it or run 'git commit --no-verify' to skip the check." >&2
exit 1
