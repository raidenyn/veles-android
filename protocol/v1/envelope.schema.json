{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "veles.protocol.envelope.v1",
  "title": "Veles Native Messaging envelope v1",
  "description": "Strict schema for every JSON message on the Chrome Native Messaging pipe (docs/protocol/veles-v1.md section 10, OTP2-BRD-001..021). Unknown fields reject; all numbers inside offers are integers within declared ranges; optional fields are omitted entirely when absent (never null). One frame is one message: the transport length (1..65536 bytes) and UTF-8 validity are checked on the raw text before this schema applies (OTP2-BRD-001/002), and duplicate object keys are rejected from the raw text (OTP2-BRD-002). record_base64/advertisement are opaque byte transport (OTP2-CON-004): this schema checks only canonical padding shape; canonical pad-bit and decoded-length checks live in the test-only envelope checks. Field order is irrelevant (OTP2-BRD-002). NOTE (OTP2-BRD-002a): JSON Schema minLength/maxLength count UTF-16 code units; the NORMATIVE string bounds of the envelope are UTF-8 BYTE lengths, enforced by the test-only envelope checks.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/req_start_scan" },
    { "$ref": "#/$defs/req_stop_scan" },
    { "$ref": "#/$defs/req_connect" },
    { "$ref": "#/$defs/req_disconnect" },
    { "$ref": "#/$defs/req_send" },
    { "$ref": "#/$defs/req_shutdown" },
    { "$ref": "#/$defs/ev_ready" },
    { "$ref": "#/$defs/ev_device_found" },
    { "$ref": "#/$defs/ev_scan_state" },
    { "$ref": "#/$defs/ev_connected" },
    { "$ref": "#/$defs/ev_disconnected" },
    { "$ref": "#/$defs/ev_sent" },
    { "$ref": "#/$defs/ev_message" },
    { "$ref": "#/$defs/ev_shutdown_complete" },
    { "$ref": "#/$defs/ev_error" }
  ],
  "$defs": {
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "handle": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "service_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "platform": { "enum": ["windows", "macos"] },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "no_control_string": { "type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
    "label": {
      "allOf": [
        { "$ref": "#/$defs/no_control_string" },
        { "type": "string", "minLength": 1, "maxLength": 64 }
      ]
    },
    "platform_hint": {
      "allOf": [
        { "$ref": "#/$defs/no_control_string" },
        { "type": "string", "minLength": 1, "maxLength": 256 }
      ]
    },
    "bridge_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "stage_string": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
    "capabilities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": { "type": "string" }
    },
    "api_int": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "api_versions_list": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/api_int" }
    },
    "api_version_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/api_int" },
        "max": { "$ref": "#/$defs/api_int" }
      }
    },
    "record_base64": { "$ref": "#/$defs/base64" },
    "error_code": {
      "enum": [
        "incompatible_api",
        "invalid_request",
        "unknown_handle",
        "unknown_request",
        "invalid_base64",
        "oversize_record",
        "cap_exceeded",
        "busy",
        "scan_failed",
        "connect_failed",
        "send_failed",
        "timeout",
        "internal"
      ]
    },
    "recoverability": { "enum": ["retryable", "fatal"] },
    "scan_state_status": { "enum": ["started", "stopped"] },
    "header": {
      "type": "object",
      "required": ["envelope_version", "type"],
      "properties": {
        "envelope_version": { "const": 1 },
        "type": { "type": "string" }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "request_id"],
      "allOf": [
        {
          "if": { "required": ["api_versions"], "properties": { "api_versions": true } },
          "then": { "not": { "required": ["api_version_range"], "properties": { "api_version_range": true } } }
        },
        {
          "if": { "required": ["api_version_range"], "properties": { "api_version_range": true } },
          "then": { "not": { "required": ["api_versions"], "properties": { "api_versions": true } } }
        },
        {
          "not": {
            "allOf": [
              { "not": { "required": ["api_versions"], "properties": { "api_versions": true } } },
              { "not": { "required": ["api_version_range"], "properties": { "api_version_range": true } } }
            ]
          }
        }
      ],
      "properties": {
        "envelope_version": { "const": 1 },
        "type": { "const": "hello" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "api_version": { "$ref": "#/$defs/api_int" },
        "api_versions": { "$ref": "#/$defs/api_versions_list" },
        "api_version_range": { "$ref": "#/$defs/api_version_range" }
      }
    },
    "req_start_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "request_id", "service_uuid"],
      "properties": {
        "envelope_version": { "const": 1 },
        "type": { "const": "start_scan" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "api_version": { "$ref": "#/$defs/api_int" },
        "service_uuid": { "$ref": "#/$defs/service_uuid" }
      }
    },
    "req_stop_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "request_id", "scan_handle"],
      "properties": {
        "envelope_version": { "const": 1 },
        "type": { "const": "stop_scan" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "api_version": { "$ref": "#/$defs/api_int" },
        "scan_handle": { "$ref": "#/$defs/handle" }
      }
    },
    "req_connect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "request_id"],
      "allOf": [
        {
          "if": { "required": ["device_handle"], "properties": { "device_handle": true } },
          "then": { "not": { "required": ["platform_hint"], "properties": { "platform_hint": true } } }
        },
        {
          "if": { "required": ["platform_hint"], "properties": { "platform_hint": true } },
          "then": { "not": { "required": ["device_handle"], "properties": { "device_handle": true } } }
        },
        {
          "not": {
            "allOf": [
              { "not": { "required": ["device_handle"], "properties": { "device_handle": true } } },
              { "not": { "required": ["platform_hint"], "properties": { "platform_hint": true } } }
            ]
          }
        }
      ],
      "properties": {
        "envelope_version": { "const": 1 },
        "type": { "const": "connect" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "api_version": { "$ref": "#/$defs/api_int" },
        "device_handle": { "$ref": "#/$defs/handle" },
        "platform_hint": { "$ref": "#/$defs/platform_hint" }
      }
    },
    "req_disconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "request_id", "connection_handle"],
      "properties": {
        "envelope_version": { "const": 1 },
        "type": { "const": "disconnect" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "api_version": { "$ref": "#/$defs/api_int" },
        "connection_handle": { "$ref": "#/$defs/handle" }
      }
    },
    "req_send": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "request_id", "connection_handle", "record_base64"],
      "properties": {
        "envelope_version": { "const": 1 },
        "type": { "const": "send" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "api_version": { "$ref": "#/$defs/api_int" },
        "connection_handle": { "$ref": "#/$defs/handle" },
        "record_base64": { "$ref": "#/$defs/record_base64" }
      }
    },
    "req_shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "request_id"],
      "properties": {
        "envelope_version": { "const": 1 },
        "type": { "const": "shutdown" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "api_version": { "$ref": "#/$defs/api_int" }
      }
    },
    "ev_ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_version",
        "api_version",
        "type",
        "request_id",
        "bridge_version",
        "platform",
        "capabilities"
      ],
      "properties": {
        "envelope_version": { "const": 1 },
        "api_version": { "$ref": "#/$defs/api_int" },
        "type": { "const": "ready" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "bridge_version": { "$ref": "#/$defs/bridge_version" },
        "platform": { "$ref": "#/$defs/platform" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "ev_device_found": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "scan_handle", "device_handle", "label"],
      "properties": {
        "envelope_version": { "const": 1 },
        "api_version": { "$ref": "#/$defs/api_int" },
        "type": { "const": "device_found" },
        "scan_handle": { "$ref": "#/$defs/handle" },
        "device_handle": { "$ref": "#/$defs/handle" },
        "label": { "$ref": "#/$defs/label" },
        "platform_hint": { "$ref": "#/$defs/platform_hint" },
        "advertisement": { "$ref": "#/$defs/base64" }
      }
    },
    "ev_scan_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "scan_handle", "status"],
      "properties": {
        "envelope_version": { "const": 1 },
        "api_version": { "$ref": "#/$defs/api_int" },
        "type": { "const": "scan_state" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "scan_handle": { "$ref": "#/$defs/handle" },
        "status": { "$ref": "#/$defs/scan_state_status" }
      }
    },
    "ev_connected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "request_id", "connection_handle"],
      "properties": {
        "envelope_version": { "const": 1 },
        "api_version": { "$ref": "#/$defs/api_int" },
        "type": { "const": "connected" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "connection_handle": { "$ref": "#/$defs/handle" },
        "platform_hint": { "$ref": "#/$defs/platform_hint" }
      }
    },
    "ev_disconnected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "connection_handle"],
      "properties": {
        "envelope_version": { "const": 1 },
        "api_version": { "$ref": "#/$defs/api_int" },
        "type": { "const": "disconnected" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "connection_handle": { "$ref": "#/$defs/handle" }
      }
    },
    "ev_sent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "request_id", "connection_handle"],
      "properties": {
        "envelope_version": { "const": 1 },
        "api_version": { "$ref": "#/$defs/api_int" },
        "type": { "const": "sent" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "connection_handle": { "$ref": "#/$defs/handle" }
      }
    },
    "ev_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "connection_handle", "record_base64"],
      "properties": {
        "envelope_version": { "const": 1 },
        "api_version": { "$ref": "#/$defs/api_int" },
        "type": { "const": "message" },
        "connection_handle": { "$ref": "#/$defs/handle" },
        "record_base64": { "$ref": "#/$defs/record_base64" }
      }
    },
    "ev_shutdown_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "request_id"],
      "properties": {
        "envelope_version": { "const": 1 },
        "api_version": { "$ref": "#/$defs/api_int" },
        "type": { "const": "shutdown_complete" },
        "request_id": { "$ref": "#/$defs/request_id" }
      }
    },
    "ev_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_version", "type", "code", "recoverability", "stage"],
      "allOf": [
        {
          "if": { "required": ["scan_handle"], "properties": { "scan_handle": true } },
          "then": { "not": { "required": ["connection_handle"], "properties": { "connection_handle": true } } }
        },
        {
          "if": { "required": ["connection_handle"], "properties": { "connection_handle": true } },
          "then": { "not": { "required": ["scan_handle"], "properties": { "scan_handle": true } } }
        }
      ],
      "properties": {
        "envelope_version": { "const": 1 },
        "api_version": { "$ref": "#/$defs/api_int" },
        "type": { "const": "error" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "code": { "$ref": "#/$defs/error_code" },
        "recoverability": { "$ref": "#/$defs/recoverability" },
        "stage": { "$ref": "#/$defs/stage_string" },
        "scan_handle": { "$ref": "#/$defs/handle" },
        "connection_handle": { "$ref": "#/$defs/handle" }
      }
    }
  }
}