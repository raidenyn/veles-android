{
  "version": 1,
  "schema": "veles.protocol.binary_layouts",
  "document": "docs/protocol/veles-v1.md",
  "description": "Test-only descriptor-driven binary layout inventory for protocol v1 (OTP-02 Plan Task 2). Derived from the normative document; a disagreement with veles-v1.md is a defect that fails the checks and is never resolved in the descriptor's favor.",
  "byte_order": "unsigned big-endian (Veles network order). RFC 9382's little-endian len() quoting (TT, enrollment salt) is not a wire framing here and is exercised by the Task 5 crypto fixtures.",
  "value_rules": {
    "hex_bytes": "wire bytes in fixtures are lowercase even-length hex; decoded byte/enum field values in fixture field objects are 0x-prefixed lowercase hex strings",
    "numbers": "decoded numeric field values in fixture field objects are canonical unsigned decimal strings (u64 maximum 18446744073709551615), never JSON numbers",
    "text": "utf8 value_type fields decode to JSON strings; comparisons are byte-equality only (no normalization)",
    "fields_output": "length_prefixed fields emit <name>_len plus <name>; count_prefixed fields emit <name>_count plus <name>; opaque fields (protected-record ciphertext/tag) are omitted from fields",
    "stages": [
      "framing",
      "literal",
      "length",
      "trailing",
      "utf8",
      "enum",
      "direction",
      "point_format",
      "signature_format",
      "fragment_header",
      "fragment_index",
      "fragment_final",
      "fragment_total",
      "fragment_caps"
    ]
  },
