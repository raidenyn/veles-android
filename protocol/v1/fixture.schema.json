    "input_state_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "role",
        "steps"
      ],
      "properties": {
        "kind": {
          "const": "trace"
        },
        "role": {
          "description": "Synthetic endpoint the trace models: phone (party A / GATT peripheral) or client (party B).",
          "enum": [
            "phone",
            "client"
          ]
        },
        "machines": {
          "description": "State-machine instances the trace drives. Defaults (when absent) to the role's pairing machine and its durable record machine, peer `main`.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "machine"
            ],
            "properties": {
              "machine": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "peer": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$",
                "minLength": 1,
                "maxLength": 16
              }
            }
          }
        },
        "persisted_state": {
          "description": "Durable state the endpoint starts from: keys are `machine:peer` initial-state overrides or public persisted fields (OTP2-CRY-019g). Values are strings. Secrets reject at stage=persisted_state.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "t_ms",
              "event"
            ],
            "properties": {
              "t_ms": {
                "type": "integer",
                "minimum": 0
              },
              "event": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "peer": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$",
                "minLength": 1,
                "maxLength": 16
              },
              "pairing_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$",
                "minLength": 1,
                "maxLength": 16
              },
              "connection": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$",
                "minLength": 1,
                "maxLength": 16
              },
              "simulate": {
                "description": "Explicit SIMULATED inputs (OTP2-FIX-004): protocol outcomes like tag_ok/hmac_ok/sig_ok/act_mac_ok/peer_state, sequence numbers (canonical u64 decimal strings), and body fields. These model endpoint observations; they are NOT cryptographic conformance evidence (Plan Task 5 covers real vectors).",
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 64
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "expect": {
                "description": "Per-step declared machine states (`machine:peer` -> state). Cross-checked against the interpreter's own recomputation, never trusted.",
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "minProperties": 1
              }
            }
          }
        }
      }
    },
    "expected_state": {
      "description": "State-trace expectations. Accepted: the checker's independently recomputed final state (canonical `machine:peer=state;...` string) must equal the declared one, and every required effect must occur (forbidden effects must not). Rejected: the named state stage and absence of state mutation.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "const": true
            },
            "final_state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "effects": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "require": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "forbid": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "order": {
                  "description": "The listed effects must occur as a subsequence in exactly this relative order in the recomputed effect list.",
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted",
            "stage",
            "no_state_mutation"
          ],
          "properties": {
            "accepted": {
              "const": false
            },
            "stage": {
              "$ref": "#/$defs/state_stage"
            },
            "no_state_mutation": {
              "const": true
            }
          }
        }
      ]
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^OTP2-[A-Z]{3}-[0-9]{3}[a-z]{0,2}$"
    },
    "field": {
      "description": "One decoded field value: canonical decimal string (numeric), 0x-scalar (enum), 0x-prefixed hex (byte fields), plain text string, or nested array/object. Loader applies the per-key value class derived from binary-layouts.json; the schema keeps the outer shape.",
