              "description": "How rejection is independently proven: derived outputs differ (confirmation_mismatch), the strict validator rejects the encoding (strict_validation), or AEAD verification fails (aead_failure).",
              "enum": [
                "confirmation_mismatch",
                "strict_validation",
                "aead_failure"
              ]
