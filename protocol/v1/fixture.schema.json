    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fixture_version",
        "category",
        "requirement_ids",
        "input",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 80
        },
        "fixture_version": {
          "const": 1
        },
        "category": {
          "enum": [
            "encoding",
            "fragmentation",
            "bridge",
            "state",
            "crypto"
          ]
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirement_id"
          }
        },
        "input": {
          "oneOf": [
            {
              "$ref": "#/$defs/input_encoding"
            },
            {
              "$ref": "#/$defs/input_fragmentation"
            },
            {
              "$ref": "#/$defs/input_bridge_env_request"
            },
            {
              "$ref": "#/$defs/input_bridge_env_event"
            },
            {
              "$ref": "#/$defs/input_bridge_negotiation"
            },
            {
              "$ref": "#/$defs/input_bridge_trace"
            },
            {
              "$ref": "#/$defs/input_state_trace"
            },
            {
              "$ref": "#/$defs/input_crypto"
            }
          ]
        },
        "expected": true
      },
      "allOf": [
        {
          "description": "The category selects the expected shape: crypto fixtures use the crypto branch (positives carry verified outputs, negatives name the rejection stage); bridge fixtures must use the bridge branch (they can never be structurally distinguished otherwise); state-trace fixtures must use the state branch.",
          "if": {
            "required": [
              "category"
            ],
            "properties": {
              "category": {
                "const": "crypto"
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "$ref": "#/$defs/expected_crypto"
              }
            }
          },
          "else": {
            "if": {
              "required": [
                "category"
              ],
              "properties": {
                "category": {
                  "const": "bridge"
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "$ref": "#/$defs/expected_bridge"
                }
              }
            },
            "else": {
              "if": {
                "required": [
                  "category"
                ],
                "properties": {
                  "category": {
                    "const": "state"
                  }
                }
              },
              "then": {
                "properties": {
                  "expected": {
                    "$ref": "#/$defs/expected_state"
                  }
                }
              },
              "else": {
                "properties": {
                  "expected": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/expected_encoding"
                      },
                      {
                        "$ref": "#/$defs/expected_fragmentation"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
