{
  "version": 1,
  "requirements": {
    "java-home": {
      "kind": "tool",
      "resolver": "java-home",
      "args": {},
      "fix": "Install a JDK 21 (the version in .java-version) and put it on PATH, then run `python3 -I scripts/verify.py config set java_home <jdk>`, or set JAVA_HOME."
    },
    "android-sdk": {
      "kind": "tool",
      "resolver": "android-sdk",
      "args": {},
      "fix": "Set sdk.dir in android/local.properties or ANDROID_HOME/ANDROID_SDK_ROOT to the Android SDK, else run `python3 -I scripts/verify.py config set android_sdk <dir>`."
    },
    "android-ndk": {
      "kind": "tool",
      "resolver": "android-ndk",
      "args": {},
      "fix": "Install the NDK pinned in rust/ndk-version (`sdkmanager \"ndk;<version>\"`, the version from `./gradlew -q rustNdkVersion`), then set ANDROID_NDK_HOME or run `python3 -I scripts/verify.py config set android_ndk <dir>`."
    },
    "rustup": {
      "kind": "tool",
      "resolver": "rustup-toolchain",
      "args": {"toolchain_file": "rust/rust-toolchain.toml"},
      "fix": "Run `rustup show active-toolchain` in rust/ so the pinned channel is installed."
    },
    "rustup-host": {
      "kind": "tool",
      "resolver": "rustup-toolchain",
      "args": {"toolchain_file": "native-bridge/host/rust-toolchain.toml"},
      "fix": "Run `rustup show active-toolchain` in native-bridge/host/ so the pinned channel is installed."
    },
    "rustup-installer": {
      "kind": "tool",
      "resolver": "rustup-toolchain",
      "args": {"toolchain_file": "native-bridge/installer/rust-toolchain.toml"},
      "fix": "Run `rustup show active-toolchain` in native-bridge/installer/ so the pinned channel is installed."
    },
    "rustup-bridge": {
      "kind": "tool",
      "resolver": "rustup-toolchain",
      "args": {"toolchain_file": "native-bridge/src-tauri/rust-toolchain.toml"},
      "fix": "Run `rustup show active-toolchain` in native-bridge/src-tauri/ so the pinned 1.98.0 channel is installed."
    },
    "node": {
      "kind": "tool",
      "resolver": "path-tool",
      "args": {"program": "node", "version_cmd": ["node", "--version"], "min": "22"},
      "fix": "Install Node 22 or newer and put it on PATH, or run `python3 -I scripts/verify.py config set path_prepend <node bin>`."
    },
    "npm": {
      "kind": "tool",
      "resolver": "path-tool",
      "args": {"program": "npm", "version_cmd": ["npm", "--version"]},
      "fix": "Install npm with Node and put it on PATH (CI provisions npm 11.19.0), or run `python3 -I scripts/verify.py config set path_prepend <node bin>`."
    },
    "python": {
      "kind": "tool",
      "resolver": "path-tool",
      "args": {"program": "python3", "version_cmd": ["python3", "--version"], "min": "3.8"},
      "fix": "Install Python 3.8 or newer and put it on PATH, or run `python3 -I scripts/verify.py config set path_prepend <dir>`."
    },
    "cargo-deny": {
      "kind": "tool",
      "resolver": "path-tool",
      "args": {"program": "cargo-deny", "version_cmd": ["cargo-deny", "--version"]},
      "fix": "Run `./gradlew installCargoDeny`, which installs the pinned tool under build/verify-tools/, and put its bin directory on PATH."
    },
    "cargo-cyclonedx": {
      "kind": "tool",
      "resolver": "path-tool",
      "args": {"program": "cargo-cyclonedx", "version_cmd": ["cargo-cyclonedx", "cyclonedx", "--version"]},
      "fix": "Run `./gradlew verifyCargoCyclonedx`, which installs the pinned SBOM tool under build/verify-tools/, and put its bin directory on PATH."
    },
    "playwright-chromium": {
      "kind": "tool",
      "resolver": "playwright-chromium",
      "args": {},
      "fix": "Run `cd web-extension && node_modules/.bin/playwright-core install --with-deps chromium` (CI ties the browser build to its pinned ubuntu-24.04 image), or set VELES_TEST_CHROMIUM to an existing Chromium executable."
    },
    "web-extension.node-modules": {
      "kind": "path",
      "path": "web-extension/node_modules",
      "fix": "Run `cd web-extension && npm ci` (CI runs `npm ci --ignore-scripts`)."
    },
    "native-bridge.node-modules": {
      "kind": "path",
      "path": "native-bridge/node_modules",
      "fix": "Run `cd native-bridge && npm ci --ignore-scripts` (or `./gradlew bridgeInstall`)."
    },
    "verify.node-modules": {
      "kind": "path",
      "path": "verify/node_modules",
      "fix": "Run `npm ci --ignore-scripts --prefix verify`."
    },
    "rust.wasm": {
      "kind": "generated",
      "path": "web-extension/rust-wasm/pkg",
      "producer": "rust.wasm",
      "fix": "Run `./gradlew rustWasm` (the producer); it needs the Java and Rust toolchains."
    },
    "web-extension.build": {
      "kind": "generated",
      "path": "web-extension/dist",
      "producer": "web-extension.build",
      "fix": "Run `cd web-extension && npm run build` (the producer), after `./gradlew rustWasm`."
    }
  },
  "producers": [
    {
      "id": "rust.wasm",
      "cwd": ".",
      "run": ["./gradlew", "rustWasm"],
      "requires": ["java-home", "rustup"],
      "inputs": [
        {"path": "{gradle_user_home}/gradle.properties"},
        {"path": "{gradle_user_home}/init.d/"},
        {"path": "rust/veles-crypto/"},
        {"path": "rust/Cargo.toml"},
        {"path": "rust/Cargo.lock"},
        {"path": "rust/rust-toolchain.toml"},
        {"path": "rust/toolchain-tools.toml"},
        {"path": "rust/ndk-version"},
        {"path": "rust/build.gradle.kts"},
        {"path": "rust/settings.gradle.kts"}
      ]
    },
    {
      "id": "rust.hostJni",
      "cwd": ".",
      "run": ["./gradlew", "rustHostJni"],
      "requires": ["java-home", "rustup"],
      "inputs": [
        {"path": "{gradle_user_home}/gradle.properties"},
        {"path": "{gradle_user_home}/init.d/"},
        {"path": "rust/veles-crypto/"},
        {"path": "rust/Cargo.toml"},
        {"path": "rust/Cargo.lock"},
        {"path": "rust/rust-toolchain.toml"},
        {"path": "rust/toolchain-tools.toml"},
        {"path": "rust/ndk-version"},
        {"path": "rust/build.gradle.kts"},
        {"path": "rust/settings.gradle.kts"}
      ]
    },
    {
      "id": "web-extension.build",
      "cwd": "web-extension",
      "run": ["npm", "run", "build"],
      "requires": ["node", "npm", "web-extension.node-modules", "rust.wasm"],
      "inputs": [
        {"path": "web-extension/node_modules", "mode": "stat"}
      ]
    }
  ],
